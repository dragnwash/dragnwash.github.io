{
  "name": "game-wiki-template-github-io",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "tsx scripts/validate-config.ts && node scripts/audit-clean.mjs",
    "build": "npm run validate && npm run build:site && npm run audit:seo && npm run qa:artifact && npm run qa:freeze && npm run qa:expansion",
    "build:site": "next build --webpack && node scripts/postbuild.mjs",
    "audit:seo": "tsx scripts/audit-seo.ts",
    "qa:artifact": "node --import tsx scripts/qa-artifact.mjs",
    "qa:freeze": "node --import tsx scripts/qa-freeze.mjs",
    "qa:expansion": "node --import tsx scripts/qa-expansion.mjs",
    "package": "node scripts/package-template.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
