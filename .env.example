# Public site URL for canonical, sitemap, OG, and robots (user site root).
# Example for this project: https://dragnwash.github.io
NEXT_PUBLIC_SITE_URL=

# Leave empty for GitHub user/organization Pages at the domain root.
# Do not set /drag-n-wash for dragnwash.github.io.
NEXT_PUBLIC_BASE_PATH=

# Optional custom domain hostname without protocol (usually empty for *.github.io).
NEXT_PUBLIC_CUSTOM_DOMAIN=

# Optional theme preset override (defaults to site.json / void-violet).
NEXT_PUBLIC_THEME_PRESET=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXX). Leave empty to disable.
# Prefer baking into content/generated/integrations.json (gaMeasurementId) for static export.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Pirsch analytics identification code. Leave empty to disable.
# Ignored when Google Analytics is configured.
NEXT_PUBLIC_PIRSCH_CODE=

# Adsterra units are hardcoded for this site in config/adsterra.ts
# (desktop banner, mobile banner, native banner, social bar).

# Optional search-engine verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
